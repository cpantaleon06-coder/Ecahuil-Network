{
  "name": "@ecahuil/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Shared zod schemas, TypeScript types and port interfaces for Ecahuil Network.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@ecahuil/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@ecahuil/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "vitest": "^5.0.3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  }
}
